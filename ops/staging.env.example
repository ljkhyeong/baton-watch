# 사용 전에 이 파일을 저장소 밖이나 ops/staging.env로 복사합니다.
# 참조하는 비밀 파일에는 비밀값 하나와 마지막 줄바꿈만 포함해야 합니다.

WATCH_COMPOSE_PROJECT_NAME=baton-watch-staging
WATCH_IMAGE_REVISION=

WATCH_DB_PASSWORD_FILE=${HOME}/.config/baton-watch/staging/secrets/postgres-password
WATCH_API_TOKEN_FILE=${HOME}/.config/baton-watch/staging/secrets/watch-api-token
WATCH_TUNNEL_TOKEN_FILE=${HOME}/.config/baton-watch/staging/secrets/cloudflare-tunnel-token

WATCH_DB_NAME=baton_watch
WATCH_DB_USER=baton_watch
WATCH_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8
WATCH_PERSISTENCE_TRANSACTION_TIMEOUT=5s
WATCH_PERSISTENCE_LOCK_TIMEOUT=1s
SPRING_JDBC_TEMPLATE_QUERY_TIMEOUT=5s
