{
  "id": null,
  "uid": "baton-watch-overview",
  "title": "BATON WATCH 운영 현황",
  "description": "기존 Prometheus에 연결하는 대시보드 템플릿입니다. 수집기와 외부 알림은 별도로 설정하세요. 점검·전달 활성 여부를 나타내는 레이블은 운영 설정에 맞춰 관리하세요.",
  "tags": [
    "BATON WATCH",
    "운영"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "instance",
        "label": "인스턴스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": {
          "query": "label_values(up{job=\"baton-watch\"}, instance)",
          "refId": "인스턴스조회"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "전체",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "수집 상태",
      "description": "1은 수집 성공, 0은 실패입니다. 데이터가 없으면 수집 대상 누락 경보를 확인하세요.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (up{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "최대 점검 지연 시간",
      "description": "지금 실행 가능한 점검 중 가장 오래 지연된 시간입니다. 점유 중인 작업은 제외합니다. 점검 중지 여부도 확인하세요.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (baton_watch_check_schedule_delay_seconds{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "미전달 이벤트 수",
      "description": "같은 DB를 쓰는 인스턴스의 값을 합산하면 중복 집계됩니다. 전달이 꺼져 있어도 미전달 이벤트는 보관됩니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (baton_watch_event_delivery_backlog{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "미전달 이벤트 최대 대기 시간",
      "description": "전달이 꺼져 있어도 대기 시간은 늘어납니다. 장애 판단 전에 전달 설정이 켜져 있는지 확인하세요.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (baton_watch_event_delivery_oldest_age_seconds{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "결과별 초당 시도 수",
      "description": "점검과 전달을 결과별로 표시합니다. 시도 이력이 없는 결과는 표시되지 않을 수 있습니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, outcome) (rate(baton_watch_check_attempts_total{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "점검 {{instance}} {{outcome}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance, outcome) (rate(baton_watch_event_delivery_attempts_total{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "전달 {{instance}} {{outcome}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "평균 HTTP 소요 시간",
      "description": "총 소요 시간을 시도 횟수로 나눈 평균입니다. 백분위수와 다르며, 시도가 없으면 값이 표시되지 않을 수 있습니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(baton_watch_check_duration_seconds_sum{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval])) / sum by (instance) (rate(baton_watch_check_duration_seconds_count{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "점검 {{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(baton_watch_event_delivery_duration_seconds_sum{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval])) / sum by (instance) (rate(baton_watch_event_delivery_duration_seconds_count{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "전달 {{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "최근 5분 완료 처리 실패 건수",
      "description": "점검과 전달을 구분해 표시합니다. 실패 이력이 없으면 값이 표시되지 않을 수 있습니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (increase(baton_watch_check_finalizations_total{job=\"baton-watch\",instance=~\"$instance\",status=\"failure\"}[5m]))",
          "legendFormat": "점검 {{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (increase(baton_watch_event_delivery_finalizations_total{job=\"baton-watch\",instance=~\"$instance\",status=\"failure\"}[5m]))",
          "legendFormat": "전달 {{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "최근 5분 만료 리스 회수 횟수",
      "description": "프로세스 중단이나 완료 처리 지연이 있었는지 확인하세요. 카운터 초기화는 increase 함수가 보정합니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
