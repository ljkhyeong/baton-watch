{
  "id": null,
  "uid": "baton-watch-overview",
  "title": "BATON WATCH 운영 현황",
  "description": "기존 Prometheus 메트릭용 템플릿이다. 수집기·외부 알림을 배포하지 않으며 전달 활성·점검 중지 레이블은 운영 설정과 함께 관리한다.",
  "tags": [
    "BATON WATCH",
    "운영"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "instance",
        "label": "인스턴스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": {
          "query": "label_values(up{job=\"baton-watch\"}, instance)",
          "refId": "인스턴스조회"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "전체",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "수집 상태",
      "description": "1은 수집 성공, 0은 실패다. 시계열 자체가 없으면 별도 수집 대상 누락 경보를 확인한다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (up{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "가장 오래 밀린 점검",
      "description": "현재 선점할 수 있는 점검 중 가장 오래된 일정 지연이다. 활성 리스는 제외하며 점검 중지 여부를 함께 확인한다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (baton_watch_check_schedule_delay_seconds{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "미전달 이벤트 수",
      "description": "같은 DB를 사용하는 인스턴스의 값을 합산하지 않는다. 전달 비활성 중에도 미전달 이벤트는 보존된다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (baton_watch_event_delivery_backlog{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "가장 오래된 미전달 이벤트 경과 시간",
      "description": "전달 비활성 중에도 경과 시간이 늘 수 있다. 실제 장애 판단에는 전달 활성 상태가 필요하다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (baton_watch_event_delivery_oldest_age_seconds{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "결과별 시도율",
      "description": "점검과 전달의 결과 분류를 구분한다. 시도하지 않은 결과의 시계열은 없을 수 있다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, outcome) (rate(baton_watch_check_attempts_total{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "점검 {{instance}} {{outcome}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance, outcome) (rate(baton_watch_event_delivery_attempts_total{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "전달 {{instance}} {{outcome}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "평균 HTTP 소요 시간",
      "description": "합계 시간을 시도 횟수로 나눈 평균이다. 백분위 지연이 아니며 시도가 없으면 값이 없을 수 있다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(baton_watch_check_duration_seconds_sum{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval])) / sum by (instance) (rate(baton_watch_check_duration_seconds_count{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "점검 {{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(baton_watch_event_delivery_duration_seconds_sum{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval])) / sum by (instance) (rate(baton_watch_event_delivery_duration_seconds_count{job=\"baton-watch\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "전달 {{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "최근 5분 완료 처리 실패",
      "description": "점검과 전달을 별도 시계열로 표시한다. 실패한 적 없는 카운터는 아직 없을 수 있다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (increase(baton_watch_check_finalizations_total{job=\"baton-watch\",instance=~\"$instance\",status=\"failure\"}[5m]))",
          "legendFormat": "점검 {{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (increase(baton_watch_event_delivery_finalizations_total{job=\"baton-watch\",instance=~\"$instance\",status=\"failure\"}[5m]))",
          "legendFormat": "전달 {{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "최근 5분 만료 리스 회수",
      "description": "프로세스 중단과 완료 지연 여부를 함께 확인한다. 카운터 재시작은 increase가 처리한다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (increase(baton_watch_check_lease_recoveries_total{job=\"baton-watch\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "점검 {{instance}} ",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (increase(baton_watch_event_delivery_lease_recoveries_total{job=\"baton-watch\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "전달 {{instance}} ",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "최근 5분 예약 작업 완료",
      "description": "빈 배치도 완료 횟수에 포함된다. 누락을 0으로 채우지 않으며 별도 미실행 경보와 함께 확인한다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, code_function) (increase(tasks_scheduled_execution_seconds_count{job=\"baton-watch\",instance=~\"$instance\",code_namespace=~\"com[.]personal[.]baton[.]watch[.]bootstrap[.].*\"}[5m]))",
          "legendFormat": "{{instance}} {{code_function}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "JVM과 DB의 시계 편차",
      "description": "JVM 시각에서 DB 시각을 뺀 초 단위 값이다. 절댓값 1초는 경보 예시의 시작 기준이며 SLO가 아니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (baton_watch_database_clock_offset_seconds{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "DB 연결 풀 사용·대기",
      "description": "대기 연결 수가 지속되면 DB 응답 시간과 점유·완료 실패를 함께 확인한다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance, pool) (hikaricp_connections_active{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "사용 {{instance}} {{pool}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "max by (instance, pool) (hikaricp_connections_pending{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "대기 {{instance}} {{pool}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "현재 실행 중인 외부 요청",
      "description": "인스턴스별 점검·전달 요청 수다. HTTP 실행 스레드 수를 별도로 늘리지 않는다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (baton_watch_check_inflight{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "점검 {{instance}} ",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "max by (instance) (baton_watch_event_delivery_inflight{job=\"baton-watch\",instance=~\"$instance\"})",
          "legendFormat": "전달 {{instance}} ",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    }
  ]
}
