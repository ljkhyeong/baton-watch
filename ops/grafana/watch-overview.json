          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "DB 연결 풀 사용·대기",
      "description": "DB 연결을 기다리는 요청이 계속 있으면 DB 응답 시간과 작업 점유·완료 처리 실패를 확인하세요.",
      "type": "timeseries",
