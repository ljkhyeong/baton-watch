        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (increase(baton_watch_check_lease_recoveries_total{job=\"baton-watch\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "점검 {{instance}} ",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (increase(baton_watch_event_delivery_lease_recoveries_total{job=\"baton-watch\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "전달 {{instance}} ",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "최근 5분 예약 작업 완료 횟수",
      "description": "처리할 항목이 없는 배치도 완료 횟수에 포함합니다. 데이터가 없을 때 0으로 표시하지 않으므로 작업 미실행 경보도 확인하세요.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, code_function) (increase(tasks_scheduled_execution_seconds_count{job=\"baton-watch\",instance=~\"$instance\",code_namespace=~\"com[.]personal[.]baton[.]watch[.]bootstrap[.].*\"}[5m]))",
          "legendFormat": "{{instance}} {{code_function}}",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "애플리케이션·DB 시간 차이",
      "description": "JVM 시각에서 DB 시각을 뺀 값이며 단위는 초입니다. ±1초는 경보 설정의 초기 예시값이며 SLO가 아닙니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
