WATCH_HOST_BIND=127.0.0.1
WATCH_HOST_PORT=8080
JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8"
WATCH_DB_NAME=baton_watch
WATCH_DB_USER=baton_watch
WATCH_DB_PASSWORD=replace-with-a-local-password
WATCH_API_TOKEN=replace-with-at-least-32-random-characters
# HikariCP 풀은 최대 1~32, 최소 유휴 0~32이며 최소 유휴는 최대 풀 이하여야 합니다.
# 연결·검증 제한은 각각 250~30000ms이고 검증 제한은 연결 제한보다 작아야 합니다.
# 유휴 10000~1800000ms, 최대 수명 30000~3600000ms, 생존 확인 30000~1800000ms이며
# 가변 풀의 유휴 제한은 최대 수명보다 1000ms 이상 짧고, 생존 확인은 최대 수명보다
# 짧아야 하며 초기화 실패 제한은 1~30000ms입니다.
WATCH_DB_MAXIMUM_POOL_SIZE=8
WATCH_DB_MINIMUM_IDLE=2
WATCH_DB_CONNECTION_TIMEOUT_MILLIS=3000
WATCH_DB_VALIDATION_TIMEOUT_MILLIS=1000
WATCH_DB_IDLE_TIMEOUT_MILLIS=600000
WATCH_DB_MAX_LIFETIME_MILLIS=1800000
WATCH_DB_KEEPALIVE_TIME_MILLIS=120000
WATCH_DB_INITIALIZATION_FAIL_TIMEOUT_MILLIS=5000
# pgJDBC 연결·로그인·취소 제한은 1~30초, 소켓 제한은 1~120초입니다.
WATCH_DB_CONNECT_TIMEOUT_SECONDS=3
WATCH_DB_LOGIN_TIMEOUT_SECONDS=5
WATCH_DB_SOCKET_TIMEOUT_SECONDS=10
WATCH_DB_CANCEL_SIGNAL_TIMEOUT_SECONDS=3
# TCP keepalive는 명확성을 위해 true 또는 false 사용을 권장합니다.
WATCH_DB_TCP_KEEP_ALIVE=true
# JDBC 트랜잭션 제한 시간도 1~30초의 정수 초 단위 기간이어야 합니다.
WATCH_PERSISTENCE_TRANSACTION_TIMEOUT=5s
WATCH_PERSISTENCE_LOCK_TIMEOUT=1s
# JDBC 구문 제한 시간은 1~30초의 정수 초 단위 기간이어야 합니다.
WATCH_PERSISTENCE_QUERY_TIMEOUT=5s
# 점검·전달의 직렬 배치는 65초 종료 대기보다 짧은 60초 안에 끝나야 합니다.
WATCH_WORKER_EXECUTION_BUDGET=60s
WATCH_EVENT_DELIVERY_ENABLED=false
WATCH_EVENT_DELIVERY_ENDPOINT=https://baton.example.com/api/v1/internal/resource-health-events
# 콜백 토큰은 [A-Za-z0-9._~-] 문자 32~200개를 사용합니다.
WATCH_EVENT_DELIVERY_TOKEN=replace-with-a-separate-32-character-token
